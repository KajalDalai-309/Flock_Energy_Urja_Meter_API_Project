          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Upstream portal/session error"
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": [
          "API"
        ],
        "summary": "Swagger UI",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "502": {
            "description": "Upstream portal/session error"
          }
        }
      }
    }
  }
}